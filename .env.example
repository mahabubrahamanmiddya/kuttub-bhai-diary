# ==============================================================================
# DIGITAL DIARY — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Side Service Role Key (Used for unattended automated backups via API / GitHub Actions)
# NEVER expose this on the client side!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Personal Google Drive Automated Backup (Google OAuth 2.0 with Refresh Token)
# Follow the step-by-step guide in docs/GOOGLE_DRIVE_SETUP_GUIDE.md
# Or run: node scripts/get-google-refresh-token.mjs
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=1//04your-permanent-refresh-token

# ------------------------------------------------------------------------------
# 3. Scheduled Cron Secret (Secures /api/backup/schedule endpoint)
# ------------------------------------------------------------------------------
CRON_SECRET=your-random-secure-cron-secret-token

# ------------------------------------------------------------------------------
# 4. Application Metadata
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="My Diary"
